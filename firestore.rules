rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /donations/{donationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /game_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
